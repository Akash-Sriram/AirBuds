<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp"
    android:paddingHorizontal="2dp">

    <!-- Battery Pills Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- Left Bud -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_notif_pill"
            android:paddingVertical="6dp"
            android:paddingHorizontal="6dp"
            android:layout_marginEnd="3dp">

            <ImageView
                android:id="@+id/notif_iv_left"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_earbud_left" />

            <TextView
                android:id="@+id/notif_tv_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#E0E0E0"
                android:layout_marginStart="5dp" />

            <ImageView
                android:id="@+id/notif_iv_charge_left"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:src="@drawable/ic_charging_bolt"
                android:visibility="gone"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <!-- Case -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_notif_pill"
            android:paddingVertical="6dp"
            android:paddingHorizontal="6dp"
            android:layout_marginHorizontal="2dp">

            <ImageView
                android:id="@+id/notif_iv_case"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_case" />

            <TextView
                android:id="@+id/notif_tv_case"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#E0E0E0"
                android:layout_marginStart="5dp" />

            <ImageView
                android:id="@+id/notif_iv_charge_case"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:src="@drawable/ic_charging_bolt"
                android:visibility="gone"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <!-- Right Bud -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_notif_pill"
            android:paddingVertical="6dp"
            android:paddingHorizontal="6dp"
            android:layout_marginStart="3dp">

            <ImageView
                android:id="@+id/notif_iv_right"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_earbud_right" />

            <TextView
                android:id="@+id/notif_tv_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#E0E0E0"
                android:layout_marginStart="5dp" />

            <ImageView
                android:id="@+id/notif_iv_charge_right"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:src="@drawable/ic_charging_bolt"
                android:visibility="gone"
                android:layout_marginStart="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Noise Control Buttons Row -->
    <LinearLayout
        android:id="@+id/notif_ll_anc_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- ANC On -->
        <TextView
            android:id="@+id/notif_btn_anc"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ANC"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_notif_anc_active"
            android:layout_marginEnd="3dp" />

        <!-- Normal / Off -->
        <TextView
            android:id="@+id/notif_btn_off"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Off"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#A0A0A0"
            android:background="@drawable/bg_notif_anc_inactive"
            android:layout_marginHorizontal="2dp" />

        <!-- Transparency -->
        <TextView
            android:id="@+id/notif_btn_trans"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Transparency"
            android:textStyle="bold"
            android:textSize="11sp"
            android:textColor="#A0A0A0"
            android:background="@drawable/bg_notif_anc_inactive"
            android:layout_marginStart="3dp" />
    </LinearLayout>
</LinearLayout>
