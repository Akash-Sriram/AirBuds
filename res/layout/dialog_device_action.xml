<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="20dp">

    <!-- Header: Device Icon, Name & Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_dialog_dev_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_device_phone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tv_dialog_dev_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device Name"
                android:textColor="@color/text_main"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_dialog_dev_mac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00:00:00:00"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_dialog_dev_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connected"
            android:textColor="@color/success"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/pill_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_border"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp" />

    <!-- LOCAL DEVICE ACTIONS (Visible only for 'This Phone') -->
    <LinearLayout
        android:id="@+id/ll_dialog_local_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Action: Disconnect This Phone -->
        <LinearLayout
            android:id="@+id/row_action_disconnect_local"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp"
            android:paddingHorizontal="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_disconnect" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disconnect Earbuds"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Close app session and open Bluetooth Settings"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action: Unpair / Forget This Phone -->
        <LinearLayout
            android:id="@+id/row_action_unpair_local"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp"
            android:paddingHorizontal="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_delete" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unpair from This Phone"
                    android:textColor="#E53935"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open Bluetooth Settings to unpair / forget device"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- REMOTE DEVICE INFO SECTION (Visible for remote devices) -->
    <LinearLayout
        android:id="@+id/ll_dialog_remote_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_section_bg"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_dialog_remote_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MULTIPOINT AUDIO MANAGEMENT"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tv_dialog_remote_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="realme Buds Air 8 manages dual-device connections automatically at the hardware level.\n\n• Audio Switching: Start audio playback on any connected device and the earbuds switch automatically.\n• Disconnection: To disconnect this device, turn off its Bluetooth or disconnect from its Bluetooth menu (remote disconnection is locked in earbud firmware)."
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>

    <!-- Close Button -->
    <Button
        android:id="@+id/btn_dialog_close"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:text="Close"
        android:textAllCaps="false"
        android:textColor="@color/text_main"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/btn_inactive" />

</LinearLayout>
