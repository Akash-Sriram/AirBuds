<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="20dp">

    <!-- Top Drag Handle Pill -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/card_border"
        android:layout_marginBottom="14dp" />

    <!-- Top Navigation Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/btn_dialog_eq_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/text_main"
            android:textSize="22sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tv_dialog_eq_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Custom1"
            android:textColor="@color/text_main"
            android:textSize="17sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Sub-header Row: Equalizer label & Reset button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Equalizer"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_dialog_eq_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset"
            android:textColor="#1677FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <!-- Custom Interactive 6-Band Frequency Response Graph -->
    <org.airbridge.tws.EqGraphView
        android:id="@+id/eq_graph_view"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginBottom="16dp" />

    <!-- Done / Close Button -->
    <Button
        android:id="@+id/btn_dialog_eq_close"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Done"
        android:textColor="#FFFFFF"
        android:background="@drawable/btn_primary"
        android:textSize="14sp"
        android:textStyle="bold" />



</LinearLayout>
